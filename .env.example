# ERVIA Web — variables de entorno (sin valores reales)
# Copia este archivo a .env.local para desarrollo. .env* está ignorado por git, salvo .env.example.

# Entorno del sitio: "production" | "staging".
# - production: el sitio se indexa (salvo que una página lo impida).
# - staging (o cualquier otro valor / vacío): añade <meta name="robots" content="noindex,nofollow">.
# Es NEXT_PUBLIC_*: Next.js la incrusta en el build, así que debe estar definida ANTES de construir
# (en Dokploy: Environment de la app; en local: .env.local).
NEXT_PUBLIC_SITE_ENV=staging

# --- Se usarán en fases posteriores (G6) ---
# URL del webhook de n8n que recibe los leads. Solo servidor. NUNCA se expone al navegador.
LEAD_WEBHOOK_URL=
# Secreto compartido con n8n (cabecera X-ERVIA-Secret). Solo servidor.
LEAD_WEBHOOK_SECRET=
